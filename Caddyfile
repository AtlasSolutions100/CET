# TLS, and the two things a plan-set upload needs from a reverse proxy.
{$SITE_HOST} {
	encode zstd gzip

	reverse_proxy app:8100 {
		# A cold detect on a dense sheet runs well past a minute, and the
		# whole-document routes (report.pdf across 50 approved sheets) run
		# longer. Caddy's defaults would cut those off mid-flight and the
		# operator would see a 502 with no reason.
		transport http {
			read_timeout 30m
			write_timeout 30m
		}
	}

	# Plan sets are 20-50 MB and a big set is more. The default limit would
	# reject the upload, which on a hosted box is the only way in.
	request_body {
		max_size 512MB
	}

	log {
		output stdout
		format console
	}
}
