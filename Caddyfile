# Other projects on this box drop their own site blocks into conf.d.
#
# They live OUTSIDE this repo on purpose. Every deploy scp's this Caddyfile
# onto the box and overwrites it, so a site block appended here by hand is
# guaranteed to be wiped by the next takeoff release - and the other app 502s
# at the following reload with nothing to explain why. A mounted directory is
# untouched by that copy.
#
# Verified against caddy:2-alpine: an import matching ZERO files validates
# fine, so this is safe on a box where conf.d is empty.
import /etc/caddy/conf.d/*.caddy

# TLS, and the two things a plan-set upload needs from a reverse proxy.
{$SITE_HOST} {
	encode zstd gzip

	reverse_proxy app:8100 {
		# A CEILING WE CHOSE, not a default we are escaping. Measured:
		# stock Caddy proxied a backend that took 90s to send its first
		# byte and returned 200 - it has no response deadline at all. So
		# this cannot rescue a slow route; it only bounds a socket that
		# has gone silent, and 30m is set high enough to clear the slowest
		# real one (report.pdf across 50 approved sheets).
		transport http {
			read_timeout 30m
			write_timeout 30m
		}
	}

	# Also a cap we chose: measured, stock Caddy accepted a 600 MB body and
	# passed all of it through. The reason to have one is that /api/upload
	# does `raw = await file.read()` - the WHOLE body lands in memory before
	# anything is written - so with no limit one request can page out the
	# box. 512 MB is ~10x the largest real plan set (stice is 17 MB).
	# Raising this without changing that read is how the box falls over.
	request_body {
		max_size 512MB
	}

	log {
		output stdout
		format console
	}
}
