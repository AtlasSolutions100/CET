# Copy to .env on the host and fill in. Never commit .env.

# Required. The entrypoint refuses to start without it, and refuses anything
# shorter than 8 characters. Any username works at the browser prompt.
TAKEOFF_UI_PASSWORD=

# Only for docker-compose.standalone.yml (a box of its own): the hostname
# Caddy gets its TLS certificate for. On the shared workoptional box CET
# has no Caddy of its own - core's imports deploy/construction.caddy.
SITE_HOST=construction.workoptional.studio

# The product this box is. docker-compose.yml sets construction already;
# this is here for a bare `uvicorn server:app` run.
TAKEOFF_PRODUCT=construction

# Optional: the Analyze button. Leave blank and Analyze reports that it is not
# configured; everything else works without it.
XAI_API_KEY=
GROQ_API_KEY=
TAKEOFF_LLM_MODEL=grok-4-fast-reasoning

# Tuning. 4 workers x a heavy sheet peaking at multiple GB is the memory floor.
TAKEOFF_WORKERS=2
TAKEOFF_PAGE_BUDGET_S=900
APP_MEM_LIMIT=8g

# Which image tag to run. CI publishes :latest on every push to main and
# :vN.N.N on a tag - run tags in front of clients so a mid-demo push cannot
# restart the box under them.
TAG=latest
